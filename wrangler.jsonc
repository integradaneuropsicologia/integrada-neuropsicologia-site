{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "integrada-neuropsicologia",
  "account_id": "91107fae9aa1b8f1b89bd826bdcc3ba8",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  // nodejs_compat is supplied by vite.config.ts; do not repeat it here.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  // The production URL on workers.dev is off since 13/10; version/alias preview
  // URLs stay on.
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
  // Production routes (apex/* and www/*) live in the Cloudflare dashboard on
  // purpose; do not add routes or custom domains here.
}
